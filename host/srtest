import argparse
import subprocess
import time
import os
import re
import json
from pathlib import Path
from srutils import resolve_repo_root, validate_repo_root, die

CWD = Path.cwd().resolve()
REPO_ROOT = Path()
BUILD_DIR_PATH = Path()

# Core binaries that require hardware/network daemons and should be skipped
IGNORE_LIST = {
    "test_can0_gateway",
}

def extract_coverage_metrics(node_name: str) -> tuple[str, str]:
    """Invokes gcov to extract line coverage percentage and function ratios, ignoring STL overhead."""
    obj_dir = None
    
    # Locate the CMake object directory for this specific node
    for p in BUILD_DIR_PATH.rglob(f"{node_name}_logic.dir"):
        if p.is_dir():
            obj_dir = p
            break

    if not obj_dir:
        return "N/A", "N/A"

    gcda_files = list(obj_dir.rglob("*.gcda"))
    if not gcda_files:
        return "N/A", "N/A"

    try:
        # Run gcov with the -f flag to generate function-level statistics
        res = subprocess.run(
            ["gcov", "-f", str(gcda_files[0])],
            capture_output=True, text=True, cwd=str(obj_dir)
        )
        
        # Extract the total line execution percentage
        line_match = re.search(r"Lines executed:\s*([\d\.]+)%", res.stdout)
        line_str = f"{float(line_match.group(1)):.1f}%" if line_match else "0.0%"
        
        # Extract every function block and its individual execution percentage
        func_blocks = re.findall(r"Function '(.*?)'\s+Lines executed:\s*([\d\.]+)%", res.stdout)
        func_passed = 0
        func_total = 0
        
        for func_name, pct in func_blocks:
            # Filter out C++ standard library and GoogleTest template noise
            if (func_name.startswith(("_ZNSt", "_ZNKSt", "_ZSt", "_ZN9__gnu", "_ZNK9__gnu")) 
                or "testing::" in func_name):
                continue
                
            func_total += 1
            if float(pct) > 0.0:
                func_passed += 1
        
        func_str = f"{func_passed}/{func_total}" if func_total > 0 else "1/1"
        return line_str, func_str
        
    except Exception:
        return "ERR", "ERR"
    
def execute_binaries(test_binaries: list[Path], gtest_filter: str = None, output_dir: str = None) -> None:
    if not test_binaries:
        print("No verification test binaries matched the requested target scopes.")
        return

    print("============= Executing Engine Context =============")
    if gtest_filter:
        print(f"Applying GoogleTest filter pattern: '{gtest_filter}'")
    
    # Ensure the structured output directory exists if requested
    log_path = None
    if output_dir:
        log_path = Path(output_dir).resolve()
        log_path.mkdir(parents=True, exist_ok=True)
    
    results_table = []
    passed_count = 0
    failed_count = 0
    start_time = time.time()

    # Force AddressSanitizer to track memory leaks and keep console formatting intact
    env = os.environ.copy()
    env["ASAN_OPTIONS"] = "detect_leaks=1:color=always"

    for binary in test_binaries:
        node_name = binary.name.replace("test_", "")
        
        cmd = [str(binary)]
        
        # Append dynamic arguments if passed by the user
        if gtest_filter:
            cmd.append(f"--gtest_filter={gtest_filter}")
        if log_path:
            cmd.append(f"--gtest_output=xml:{log_path / f'{binary.name}_report.xml'}")
        
        asan_status = "CLEAN"
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=30, env=env)
            
            if res.returncode == 0:
                status = "PASSED"
                passed_count += 1
                line_cov, func_cov = extract_coverage_metrics(node_name)
            else:
                status = "FAILED"
                failed_count += 1
                line_cov, func_cov = "N/A", "N/A"
                
                # Catch specific memory violations to update the dashboard status
                if "AddressSanitizer" in res.stderr or "LeakSanitizer" in res.stderr:
                    asan_status = "CRASH"
                
                # Dump the crash stack trace for debugging
                print("\n" + "!"*60)
                print(f"CRASH / ERROR DIAGNOSTIC LOG IN {binary.name}:")
                print(res.stderr if res.stderr else res.stdout)
                print("!"*60 + "\n")
                
        except subprocess.TimeoutExpired:
            status = "TIMEOUT"
            failed_count += 1
            line_cov, func_cov = "N/A", "N/A"
            asan_status = "N/A"
        except Exception:
            status = "ERROR"
            failed_count += 1
            line_cov, func_cov = "N/A", "N/A"
            asan_status = "N/A"

        results_table.append({
            "target": f"{node_name}_logic",
            "status": status,
            "line_coverage": line_cov,
            "function_coverage": func_cov,
            "asan": asan_status
        })

    end_time = time.time()
    total_time = end_time - start_time

    print("\n============================= Test & Health Summary Dashboard =============================")
    print(f"{'Target Logic Block':<25} | {'Status':<10} | {'Line Coverage':<15} | {'Functions':<10} | {'ASan Status':<12}")
    print("-" * 92)
    
    for row in results_table:
        flag = ""
        # Visually flag any logic files missing sufficient test cases
        if row["status"] == "PASSED" and row["line_coverage"] != "N/A" and float(row["line_coverage"].replace("%", "")) < 60.0:
            flag = " <-- Warning: Low Coverage!"
            
        print(f"{row['target']:<25} | {row['status']:<10} | {row['line_coverage']:<15} | {row['function_coverage']:<10} | {row['asan']:<12}{flag}")

    print("=" * 92)
    print(f"Total Tests : {passed_count + failed_count}")
    print(f"Passed      : {passed_count}")
    print(f"Failed      : {failed_count}")
    print(f"Time        : {total_time:.4f} seconds")

    # Generate a high-level metadata payload for CI/CD pipelines
    if log_path:
        summary_data = {
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "metrics": {
                "total_suites": passed_count + failed_count,
                "passed": passed_count,
                "failed": failed_count,
                "execution_time_seconds": total_time
            },
            "results": results_table
        }
        with open(log_path / "summary.json", "w") as f:
            json.dump(summary_data, f, indent=4)

    if failed_count > 0:
        die("\nSome test verification workflows failed.")

def     run_all_tests(exceptions: list[str] = None, gtest_filter: str = None, output_dir: str = None) -> None:
    exception_binaries = {f"test_{node}" for node in exceptions} if exceptions else set()
    test_binaries = []
    
    # Recursively find all executable test binaries in the build directory
    for p in BUILD_DIR_PATH.rglob("test_*"):
        if p.is_file() and os.access(p, os.X_OK) and p.suffix == "":
            if p.name in IGNORE_LIST:
                continue
            if p.name in exception_binaries:
                continue
            test_binaries.append(p)
            
    execute_binaries(test_binaries, gtest_filter, output_dir)

def run_node_tests(nodes: list[str], gtest_filter: str = None, output_dir: str = None) -> None:
    test_binaries = []
    target_binary_names = {f"test_{node}" for node in nodes}
    
    # Find only the specifically requested node binaries
    for p in BUILD_DIR_PATH.rglob("test_*"):
        if p.is_file() and os.access(p, os.X_OK) and p.suffix == "" and p.name in target_binary_names:
            if p.name in IGNORE_LIST:
                continue
            test_binaries.append(p)
            
    execute_binaries(test_binaries, gtest_filter, output_dir)

def main():
    parser = argparse.ArgumentParser(description="Sunswift dynamic testing execution framework")
    
    parser.add_argument("--filter", "-f", default=None, help="GoogleTest case filter pattern")
    parser.add_argument("--output", "-o", default=None, help="Directory to save structured XML/JSON reports")
    
    level1_junction = parser.add_subparsers(dest="command", required=True)
    
    command_all = level1_junction.add_parser("all", help="Discover and execute every compiled test binary")
    command_all.add_argument("--except", "-e", nargs="+", dest="except_nodes", default=[], help="Specify node names to bypass")
    
    command_node = level1_junction.add_parser("node", help="Run tests for specific nodes")
    command_node.add_argument("nodes", nargs="+", help="Name of the node package")
    
    args = parser.parse_args()

    global REPO_ROOT, BUILD_DIR_PATH
    try:
        REPO_ROOT = resolve_repo_root(CWD)
        validate_repo_root(REPO_ROOT)
    except Exception as exc:
        die(str(exc))
        
    BUILD_DIR_PATH = REPO_ROOT / "build"
    if not BUILD_DIR_PATH.exists():
        die("Build environment missing. Run 'srbuild all' before initiating tests.")

    # CI/CD PIPELINE TOGGLE
    # This line below will be uncommented to automatically force structured test logging 
    # (XML and JSON summaries) into the build folder every time this script runs.
    # args.output = str(BUILD_DIR_PATH / "test-results")

    if args.command == "all":
        run_all_tests(exceptions=args.except_nodes, gtest_filter=args.filter, output_dir=args.output)
    elif args.command == "node":
        run_node_tests(args.nodes, gtest_filter=args.filter, output_dir=args.output)

if __name__ == "__main__":
    main()